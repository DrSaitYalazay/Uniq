# ============================================================================
# UniqSuite — ortam değişkenleri (sunucuda /root/UniqSuite/.env).
# Bu dosyayı ELLE doldurmak gerekmez: ilk deploy'da ersteinrichtung.sh .env'i
# kendisi üretir (rastgele şifreler; SMTP ayarları ClaudeCWS'ten kopyalanır).
# ============================================================================
POSTGRES_DB=cy
POSTGRES_USER=postgres
POSTGRES_PASSWORD=otomatik_uretilir
AUTHENTICATOR_PASSWORD=otomatik_uretilir
JWT_SECRET=otomatik_uretilir
PUBLIC_APP_URL=https://uniq.cyberwerk.online
CORS_ORIGIN=https://uniq.cyberwerk.online
AUTH_AUTOCONFIRM=true
# Bu adres platform admini olur (kayıt olunca veya bir sonraki deploy'da)
ADMIN_EMAIL=admin@cyberwerk.online
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
BACKUP_KEEP_DAYS=14
