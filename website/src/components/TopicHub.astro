---
/** Übersicht der Wissensseiten, gegliedert nach den sechs Schritten. */
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import Portal from './Portal.astro';
import { SITE_URL, type Lang } from '../config';
import { topics, topicHref, topicHub } from '../data/topics';
import { steps, stepHref } from '../data/steps';

interface Props { lang: Lang }
const { lang } = Astro.props;
const other = lang === 'de' ? 'en' : 'de';
const L = lang === 'de'
  ? { kicker: 'Wissen', h1: 'Die Bausteine', acc: 'der sechs Schritte.', lead: 'Geltungsbereich, Inventar, Gap-Analyse, Risikoanalyse, Erklärung zur Anwendbarkeit, Audit: Hier steht, was die Begriffe bedeuten, was ISO 27001 und das BSI-Gesetz verlangen und woran ein Prüfer erkennt, dass es gelebt wird.', step: 'Schritt', open: 'Zum Schritt', title: 'Wissen: Die Bausteine der sechs Schritte – UniqSuite' }
  : { kicker: 'Knowledge', h1: 'The building blocks', acc: 'of the six steps.', lead: 'Scope, inventory, gap analysis, risk assessment, Statement of Applicability, audit: what the terms mean, what ISO 27001 and the German BSI Act require, and how an auditor can tell it is lived.', step: 'Step', open: 'Go to step', title: 'Knowledge: the building blocks of the six steps – UniqSuite' };
const list = topics[lang];
const url = (p: string) => new URL(p, SITE_URL).href;
const jsonld = [{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: `${L.h1} ${L.acc}`, description: L.lead, inLanguage: lang, url: url(topicHub(lang)), mainEntity: { '@type': 'ItemList', itemListElement: list.map((x, i) => ({ '@type': 'ListItem', position: i + 1, name: x.title, url: url(topicHref(lang, x.key)) })) } }];
---
<Base lang={lang} path={topicHub(lang)} altPath={topicHub(other)} title={L.title} description={L.lead} jsonld={jsonld}>
  <Fragment slot="world">
    <picture>
      <source media="(max-width: 820px)" srcset="/img/still/pdca-m.webp" type="image/webp" width="720" height="1280" />
      <img class="poster sub" src="/img/still/pdca-d.webp" width="1600" height="900" alt="" decoding="async" />
    </picture>
  </Fragment>
  <article class="sp fwp tph">
    <header class="wrap fwp-head tph-head">
      <div>
        <p class="kicker">{L.kicker}</p>
        <h1>{L.h1} <span class="accent">{L.acc}</span></h1>
        <p class="lead">{L.lead}</p>
      </div>
    </header>
    {steps[lang].map((s, i) => (
      <section class={`wrap sp-block tph-step stp-${i}`} aria-labelledby={`tph-${i}`}>
        <div class="tph-side">
          <span class="tph-n">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <p class="kicker">{L.step} {i + 1} · {s.cycle}</p>
            <h2 id={`tph-${i}`} class="sp-h">{s.title}</h2>
            <a class="tp-steplink-a" href={stepHref(lang, i)}>{L.open}<Icon name="arrow" /></a>
          </div>
        </div>
        <ul class="fwp-more tph-list">
          {list.filter((x) => x.step === i).map((x) => <li class={`stp-${i}`}><a href={topicHref(lang, x.key)}><Portal glyph={x.glyph} /><b class="tp-name">{x.name}</b><span>{x.sub}</span></a></li>)}
        </ul>
      </section>
    ))}
  </article>
</Base>
