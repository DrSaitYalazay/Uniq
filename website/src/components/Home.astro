---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import { SITE_URL, LOGIN_URL, loginHref, demoHref, CONTACT_EMAIL, type Lang } from '../config';
import de from '../i18n/de';
import en from '../i18n/en';
import qcData from '../data/quickcheck.json';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = lang === 'de' ? de : en;
const other = lang === 'de' ? '/en/' : '/de/';
const FW = ['nis2', 'iso27001', 'aiact', 'iso42001', 'cra'] as const;
const counts: Record<string, number> = { nis2: 268, iso27001: 318, aiact: 130, iso42001: 111, cra: 83 };
const shot = (n: string) => `/img/shots/${lang}-${n}`;
const still = (k: string) => `/img/still/${k}`;

// Schritte des Zeitstrahls: [Start, Ende) je Scroll-Schritt
const msGroups = [[0, 2], [2, 4], [4, 6], [6, 7]];

// Strukturierte Daten
const jsonld = [
  {
    '@context': 'https://schema.org', '@type': 'Organization', name: 'UniqSuite', url: SITE_URL,
    logo: `${SITE_URL}/favicon.svg`, email: CONTACT_EMAIL,
  },
  {
    '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'UniqSuite',
    applicationCategory: 'BusinessApplication', operatingSystem: 'Web', url: LOGIN_URL,
    inLanguage: ['de', 'en'], description: t.meta.description,
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage', inLanguage: lang,
    mainEntity: (lang === 'de' ? [
      ['Gibt es ein „NIS2-Zertifikat“?', 'Nein. Das Gesetz kennt keine allgemeine Zertifizierung. Eine ISO-27001-Zertifizierung ist ein starkes Indiz für ein funktionierendes ISMS, ersetzt aber nicht den Nachweis der gesetzlichen Pflichten.'],
      ['Wir sind ISO-27001-zertifiziert. Sind wir fertig?', 'Nicht automatisch. Prüfen Sie Geltungsbereich, Meldewesen, Registrierung, Pflichten der Leitung und Lieferkette.'],
      ['Wie lange dauert eine Gap-Analyse?', 'Das hängt von Größe und Vorarbeit ab. Ein erster vollständiger Durchgang ist bei guter Vorbereitung in wenigen Arbeitstagen machbar; die Vertiefung mit Nachweisen dauert länger.'],
      ['Wir sind eine Kommune. Gilt das BSIG für uns?', 'Für die Kommunalverwaltung gelten die Regelungen Ihres Landes. Kommunale Unternehmen können dagegen unmittelbar unter das BSIG fallen.'],
      ['Müssen wir alle Anforderungen sofort erfüllen?', 'Die Pflichten gelten seit Dezember 2025. Wer noch Lücken hat, braucht einen priorisierten, von der Leitung getragenen Plan – und muss ihn sichtbar abarbeiten.'],
      ['Was gilt, wenn wir auch KI einsetzen?', 'Der AI Act gilt unabhängig von NIS2. KI-Kompetenz und Verbote gelten bereits; ein KI-Register ist der erste sinnvolle Schritt. ISO 42001 bietet dafür das Managementsystem.'],
    ] : [
      ['Is there an “NIS2 certificate”?', 'No. The law knows no general certification. ISO 27001 certification is a strong indication of a working ISMS but does not replace evidence of the statutory obligations.'],
      ['We are ISO 27001 certified. Are we done?', 'Not automatically. Check scope, incident reporting, registration, management duties and the supply chain.'],
      ['How long does a gap analysis take?', 'That depends on size and prior work. With good preparation, a first complete pass is feasible in a few working days; the deep dive with evidence takes longer.'],
      ['We are a municipality. Does the BSI Act apply to us?', 'For the municipal administration, the rules of your German state apply. Municipal companies, however, may fall directly under the BSI Act.'],
      ['Do we have to meet all requirements immediately?', 'The obligations have applied since December 2025. If you still have gaps, you need a prioritised plan backed by management – and must visibly work through it.'],
      ['What if we also use AI?', 'The AI Act applies independently of NIS2. AI literacy and the prohibitions already apply; an AI register is the sensible first step. ISO 42001 provides the management system for it.'],
    ]).map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
];

// Daten für Skripte (nicht ausführbar → CSP-konform)
const clientData = {
  lang,
  login: loginHref(lang),
  demo: demoHref(lang),
  qc: t.qc,
  pdf: t.pdfText,
  fwNames: t.frameworks,
  data: qcData,
  seg: t.pdca.phases.map((p) => ({ n: p.n, title: p.title, img: p.img })),
};
---
<Base lang={lang} path={`/${lang}/`} altPath={other} home jsonld={jsonld}>
  <Fragment slot="world">
    <picture>
      <source media="(max-width: 820px)" srcset={`${still('wolke')}-m.webp`} type="image/webp" width="720" height="1280" />
      <img class="poster" src={`${still('wolke')}-d.webp`} width="1600" height="900" alt="" fetchpriority="high" decoding="async" />
    </picture>
    <canvas data-world></canvas>
  </Fragment>

  <Fragment slot="labels">
    <div class="lbl3d lbl-ring" data-l="ring"><div class="gauge-num"><span data-count>59</span><small>%</small></div><span>{t.status.gaugeLabel}</span></div>
    {t.pdca.phases.map((p, i) => <div class="lbl3d lbl-seg" data-l={`seg-${i}`}><b>{p.n}</b><span>{p.title}</span></div>)}
    {t.deadlines.timers.map((x, i) => <div class={`lbl3d lbl-timer ${['fw-cra', 'fw-nis2', 'fw-iso27001'][i]}`} data-l={`timer-${i}`}><b>{x.value}</b><span>{x.label}</span></div>)}
    {t.deadlines.timeline.map((m, i) => <div class={`lbl3d lbl-ms fw-${m.fw}`} data-l={`ms-${i}`}><b>{m.date}</b> · {m.title}</div>)}
    {t.skyline.towers.map((x, i) => <div class={`lbl3d lbl-tower fw-${x.fw}`} data-l={`tower-${i}`}><b>{x.label}</b><span data-tower-val>{x.n}</span></div>)}
  </Fragment>

  <nav class="rail" slot="rail" aria-label={t.rail.label}>
    <ol>
      {Object.entries(t.rail.items).map(([k, v]) => (
        <li><a href={`#${k}`} data-rail={k}><span>{v}</span><i></i></a></li>
      ))}
    </ol>
  </nav>

  <!-- 01 · Wolke (Hero) -->
  <section id="wolke" class="station hero" data-u0="0" data-u1="1" aria-labelledby="h-hero">
    <picture class="still" aria-hidden="true"><source media="(max-width: 820px)" srcset={`${still('wolke')}-m.webp`} width="720" height="1280" /><img src={`${still('wolke')}-d.webp`} alt="" loading="lazy" width="1600" height="900" /></picture>
    <div class="step"><div class="wrap">
      <div class="hero-inner">
        <p class="eyebrow"><b>{lang === 'de' ? 'Stand' : 'As of'} {lang === 'de' ? 'Okt. 2026' : 'Oct 2026'}</b>{t.hero.eyebrow}</p>
        <h1 id="h-hero">{t.hero.h1a} <span class="accent">{t.hero.h1b}</span></h1>
        <p class="lead">{t.hero.sub}</p>
        <div class="cta-row">
          <a class="btn btn-primary" href="#quick-check" data-magnetic>{t.hero.ctaCheck}<Icon name="arrow" /></a>
          <a class="btn btn-ghost" href={demoHref(lang)} data-magnetic>{t.nav.demo}</a>
        </div>
        <ul class="pills" aria-label={lang === 'de' ? 'Regelwerke' : 'Frameworks'}>
          {FW.map((f) => <li class={`pill fw-${f}`}><i></i>{t.frameworks[f]}</li>)}
        </ul>
        <p class="hero-stat"><strong data-countup="910">910</strong><span>{t.hero.stat}</span></p>
      </div>
    </div></div>
    <div class="spacer"></div>
    <div class="scroll-hint" aria-hidden="true"><i></i>{t.hero.scroll}</div>
  </section>

  <!-- 02 · Konvergenz -->
  <section id="konvergenz" class="station" data-u0="1" data-u1="3.6" aria-labelledby="h-conv">
    <picture class="still" aria-hidden="true"><source media="(max-width: 820px)" srcset={`${still('konvergenz')}-m.webp`} width="720" height="1280" /><img src={`${still('konvergenz')}-d.webp`} alt="" loading="lazy" width="1600" height="900" /></picture>
    <div class="step"><div class="wrap"><div class="panel reveal">
      <p class="kicker">{t.convergence.kicker}</p>
      <h2 id="h-conv" class="h2">{t.convergence.h2a} <span class="accent">{t.convergence.h2b}</span></h2>
      <p class="lead">{t.convergence.steps[0]}</p>
    </div></div></div>
    <div class="step"><div class="wrap"><div class="panel reveal">
      <p class="big"><strong class="accent">227</strong> {t.convergence.steps[1].replace(/^227 /, '')}</p>
    </div></div></div>
    <div class="step"><div class="wrap"><div class="panel reveal">
      <p class="big">{t.convergence.steps[2]}</p>
    </div></div></div>
  </section>

  <!-- 03 · Ein klarer Stand -->
  <section id="stand" class="station" data-u0="3.6" data-u1="5" aria-labelledby="h-stand">
    <picture class="still" aria-hidden="true"><source media="(max-width: 820px)" srcset={`${still('stand')}-m.webp`} width="720" height="1280" /><img src={`${still('stand')}-d.webp`} alt="" loading="lazy" width="1600" height="900" /></picture>
    <div class="step"><div class="wrap"><div class="panel reveal">
      <p class="kicker">{t.status.kicker}</p>
      <h2 id="h-stand" class="h2">{t.status.h2}</h2>
      <p class="lead">{t.status.text}</p>
    </div></div></div>
    <div class="step"><div class="wrap"><div class="panel reveal">
      <p class="gauge-num only-no3d">59<small>%</small></p>
      <p class="small muted">{t.status.byFramework}</p>
      <div class="fw-rows">
        {t.status.rows.map((r) => (
          <div class={`fw-row fw-${r.fw}`}>
            <span>{r.label}</span>
            <svg class="bar" viewBox="0 0 100 6" preserveAspectRatio="none" role="img" aria-label={`${r.value} %`}><rect class="track" width="100" height="6" rx="3" /><rect class="val" width={r.value} height="6" rx="3" /></svg>
            <b>{r.value} %</b>
          </div>
        ))}
      </div>
      <p class="small muted">{t.status.caption}</p>
    </div></div></div>
  </section>

  <!-- 04 · Sechs Phasen -->
  <section id="pdca" class="station" data-u0="5" data-u1="11.6" aria-labelledby="h-pdca">
    <picture class="still" aria-hidden="true"><source media="(max-width: 820px)" srcset={`${still('pdca')}-m.webp`} width="720" height="1280" /><img src={`${still('pdca')}-d.webp`} alt="" loading="lazy" width="1600" height="900" /></picture>
    <div class="step"><div class="wrap"><div class="panel reveal">
      <p class="kicker">{t.pdca.kicker}</p>
      <h2 id="h-pdca" class="h2">{t.pdca.h2a} <span class="accent">{t.pdca.h2b}</span></h2>
      <p class="lead">{t.pdca.intro}</p>
      <p class="small muted">{t.pdca.note}</p>
    </div></div></div>
    {t.pdca.phases.map((p, i) => (
      <div class="step phase" id={`pdca-${i + 1}`} data-phase={i}><div class="wrap"><div class="panel reveal">
        <div class="phase-head"><span class="phase-num">{p.n}</span><span class="cycle">{p.cycle}</span></div>
        <h3 class="phase-title">{p.title}</h3>
        <p class="lead">{p.text}</p>
        <p class="result-chip">{t.pdca.resultLabel}: <b>{p.result}</b></p>
        <figure class="shot">
          <picture>
            <source srcset={`${shot(p.img)}-800.avif 800w, ${shot(p.img)}-1600.avif 1600w`} sizes="(max-width: 820px) 92vw, 34rem" type="image/avif" />
            <img src={`${shot(p.img)}-800.webp`} srcset={`${shot(p.img)}-800.webp 800w, ${shot(p.img)}-1600.webp 1600w`} sizes="(max-width: 820px) 92vw, 34rem" width="800" height="500" loading="lazy" decoding="async" alt={`${p.title} – ${lang === 'de' ? 'Bildschirmansicht' : 'screenshot'}`} />
          </picture>
          <figcaption>{t.pdca.note}</figcaption>
        </figure>
      </div></div></div>
    ))}
  </section>

  <!-- Funktionen -->
  <section id="funktionen" class="station features" data-u0="11.6" data-u1="12.2" data-dim="0.55" aria-labelledby="h-feat">
    <div class="wrap">
      <p class="kicker reveal">{t.features.kicker}</p>
      <h2 id="h-feat" class="h2 reveal">{t.features.h2a} <span class="accent">{t.features.h2b}</span></h2>
      <div class="bento">
        {t.features.items.map((f, i) => (
          <article class={`card reveal ${['c-7', 'c-5', 'c-5', 'c-7', 'c-4', 'c-4', 'c-4'][i]}`}>
            <div class="txt"><p class="lbl">{f.label}</p><h3>{f.title}</h3><p>{f.text}</p></div>
            <picture>
              <source srcset={`${shot(f.key)}-800.avif 800w, ${shot(f.key)}-1600.avif 1600w`} sizes="(max-width: 820px) 92vw, 50vw" type="image/avif" />
              <img src={`${shot(f.key)}-800.webp`} srcset={`${shot(f.key)}-800.webp 800w, ${shot(f.key)}-1600.webp 1600w`} sizes="(max-width: 820px) 92vw, 50vw" width="800" height="500" loading="lazy" decoding="async" alt={`${f.label} – ${lang === 'de' ? 'Bildschirmansicht, Demo-Mandant' : 'screenshot, demo tenant'}`} />
            </picture>
          </article>
        ))}
      </div>
      <p class="reports reveal"><Icon name="file" />{t.features.reports}</p>
    </div>
  </section>

  <!-- 05 · Fristen -->
  <section id="fristen" class="station" data-u0="12.2" data-u1="18" aria-labelledby="h-dead">
    <picture class="still" aria-hidden="true"><source media="(max-width: 820px)" srcset={`${still('fristen')}-m.webp`} width="720" height="1280" /><img src={`${still('fristen')}-d.webp`} alt="" loading="lazy" width="1600" height="900" /></picture>
    <div class="step"><div class="wrap"><div class="panel reveal">
      <p class="kicker">{t.deadlines.kicker}</p>
      <h2 id="h-dead" class="h2">{t.deadlines.h2a} <span class="accent">{t.deadlines.h2b}</span></h2>
      <p class="lead">{t.deadlines.intro}</p>
      <h3 class="res-h">{t.deadlines.timersTitle}</h3>
      <div class="timers">
        {t.deadlines.timers.map((x, i) => (
          <p class={`timer ${['fw-cra', 'fw-nis2', 'fw-iso27001'][i]}`}><b>{x.value}</b><span>{x.label}<small>{x.sub}</small></span></p>
        ))}
      </div>
      <p class="small muted">{t.deadlines.timersNote}</p>
    </div></div></div>
    {msGroups.map(([a, b], gi) => (
      <div class="step" id={gi === 0 ? 'zeitachse' : undefined}><div class="wrap"><div class="panel reveal">
        {gi === 0 && <h3 class="res-h">{t.deadlines.timelineTitle}</h3>}
        <ol class="timeline" start={a + 1}>
          {t.deadlines.timeline.slice(a, b).map((m, j) => (
            <li class={`milestone fw-${m.fw}`} data-ms={a + j}>
              <time>{m.date}</time>
              <div><h3>{m.title}</h3><p>{m.text}</p></div>
            </li>
          ))}
        </ol>
        {gi === msGroups.length - 1 && <p class="source">{t.deadlines.source}</p>}
      </div></div></div>
    ))}
  </section>

  <!-- 06 · Regelwerke -->
  <section id="regelwerke" class="station" data-u0="18" data-u1="20" aria-labelledby="h-sky">
    <picture class="still" aria-hidden="true"><source media="(max-width: 820px)" srcset={`${still('regelwerke')}-m.webp`} width="720" height="1280" /><img src={`${still('regelwerke')}-d.webp`} alt="" loading="lazy" width="1600" height="900" /></picture>
    <div class="step"><div class="wrap"><div class="panel reveal">
      <p class="kicker">{t.skyline.kicker}</p>
      <h2 id="h-sky" class="h2">{t.skyline.h2a} <span class="accent">{t.skyline.h2b}</span></h2>
    </div></div></div>
    <div class="step"><div class="wrap"><div class="panel reveal">
      <p>{t.skyline.text}</p>
      <div class="towers">
        {t.skyline.towers.map((x) => (
          <button type="button" class={`tower-btn fw-${x.fw}`} data-start={x.fw}>
            <b>{x.n}</b><span>{x.label}</span><small>{x.sub}</small>
          </button>
        ))}
      </div>
    </div></div></div>
  </section>

  <!-- Quick-Check -->
  <section id="quick-check" class="station qc" data-u0="20" data-u1="20.5" data-dim-m="0.72" aria-labelledby="h-qc">
    <div class="wrap"><div class="qc-shell">
      <p class="kicker">{t.qc.kicker}</p>
      <h2 id="h-qc" class="h2">{t.qc.h2a} <span class="accent">{t.qc.h2b}</span></h2>
      <p class="lead">{t.qc.intro}</p>
      <p class="privacy"><Icon name="eye" />{t.qc.privacy}</p>
      <div class="qc-card" data-qc aria-live="polite">
        <h3 class="res-h" data-qc-focus tabindex="-1">{t.qc.pick}</h3>
        <div class="qc-pick">
          {FW.map((f) => {
            const fw = qcData.frameworks.find((x) => x.id === f)!;
            return (
              <button type="button" class={`fw-choice fw-${f}`} data-start={f}>
                <i></i>
                <span><b>{fw.name[lang]}</b>{f === 'cra' && <small>{t.qc.craNote}</small>}</span>
                <span class="meta">{t.qc.questionsCount.replace('{n}', String(fw.questions.length))}</span>
              </button>
            );
          })}
        </div>
        <noscript><p class="qc-note">{lang === 'de' ? 'Der Quick-Check benötigt JavaScript. Ihre Antworten bleiben trotzdem in Ihrem Browser.' : 'The quick check needs JavaScript. Your answers still stay in your browser.'}</p></noscript>
      </div>
    </div></div>
  </section>

  <div class="solid" data-dim="0.94">
    <!-- Vertrauen -->
    <section id="vertrauen" class="trust" aria-labelledby="h-trust">
      <div class="wrap">
        <p class="kicker reveal">{t.trust.kicker}</p>
        <h2 id="h-trust" class="h2 reveal">{t.trust.h2a} <span class="accent">{t.trust.h2b}</span></h2>
        <div class="trust-grid">
          {t.trust.items.map((x, i) => (
            <div class="trust-item reveal"><Icon name={['layers', 'key', 'refresh', 'rules', 'globe', 'user'][i]} /><h3>{x.title}</h3><p>{x.text}</p></div>
          ))}
        </div>
        <div class="honest reveal">
          <div><p class="kicker">{t.trust.honestKicker}</p><h3>{t.trust.honestTitle}</h3></div>
          <div><p>{t.trust.honestIntro}</p><ul>{t.trust.honest.map((h) => <li>{h}</li>)}</ul></div>
        </div>
      </div>
    </section>

    <!-- White Paper -->
    <section id="white-paper" class="wp" aria-labelledby="h-wp">
      <div class="wrap"><div class="wp-card reveal">
        <div class="wp-cover"><img src={`/img/wp-cover-${lang}.webp`} width="420" height="594" loading="lazy" decoding="async" alt={t.whitepaper.title} /></div>
        <div>
          <p class="kicker">{t.whitepaper.kicker}</p>
          <h2 id="h-wp">{t.whitepaper.title}</h2>
          <p>{t.whitepaper.text}</p>
          <p class="meta">{t.whitepaper.meta}</p>
          <div class="cta-row">
            {lang === 'de'
              ? <><a class="btn btn-primary" href="/docs/UniqSuite-WhitePaper-NIS2-ISO27001-DE.pdf" download data-magnetic><Icon name="download" />{t.whitepaper.de}</a><a class="btn btn-ghost" href="/docs/UniqSuite-WhitePaper-NIS2-ISO27001-EN.pdf" hreflang="en" download>{t.whitepaper.en}</a></>
              : <><a class="btn btn-primary" href="/docs/UniqSuite-WhitePaper-NIS2-ISO27001-EN.pdf" download data-magnetic><Icon name="download" />{t.whitepaper.en}</a><a class="btn btn-ghost" href="/docs/UniqSuite-WhitePaper-NIS2-ISO27001-DE.pdf" hreflang="de" download>{t.whitepaper.de}</a></>}
          </div>
        </div>
      </div></div>
    </section>

    <!-- Schluss -->
    <section class="final" aria-labelledby="h-final">
      <div class="wrap">
        <h2 id="h-final" class="reveal">{t.final.h2a} <span class="accent">{t.final.h2b}</span></h2>
        <p class="reveal">{t.final.text}</p>
        <div class="cta-row reveal">
          <a class="btn btn-primary" href={loginHref(lang)} data-magnetic><Icon name="login" />{t.nav.login}</a>
          <a class="btn btn-ghost" href={demoHref(lang)} data-magnetic><Icon name="mail" />{t.nav.demo}</a>
        </div>
      </div>
    </section>
  </div>

  <script type="application/json" id="uq-data" is:inline set:html={JSON.stringify(clientData)} />
</Base>
