---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import { SITE_URL, LOGIN_URL, loginHref, demoHref, CONTACT_EMAIL, type Lang } from '../config';
import de from '../i18n/de';
import en from '../i18n/en';
import qcData from '../data/quickcheck.json';
import { stepHref } from '../data/steps';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = lang === 'de' ? de : en;
const other = lang === 'de' ? '/en/' : '/de/';
const FW = ['nis2', 'iso27001', 'aiact', 'iso42001', 'cra'] as const;
const counts: Record<string, number> = { nis2: 268, iso27001: 318, aiact: 130, iso42001: 111, cra: 83 };
const shot = (n: string) => `/img/shots/${lang}-${n}`;
const still = (k: string) => `/img/still/${k}`;

// Schritte des Zeitstrahls: [Start, Ende) je Scroll-Schritt
const msGroups = [[0, 2], [2, 4], [4, 6], [6, 7]];
// Bild im Hero und je Phase (responsive)
const pic = (n: string, sizes: string) => ({ avif: `${shot(n)}-800.avif 800w, ${shot(n)}-1600.avif 1600w`, webp: `${shot(n)}-800.webp 800w, ${shot(n)}-1600.webp 1600w`, src: `${shot(n)}-800.webp`, sizes });
const docs = {
  wp: { de: '/docs/UniqSuite-WhitePaper-NIS2-ISO27001-DE.pdf', en: '/docs/UniqSuite-WhitePaper-NIS2-ISO27001-EN.pdf' },
  br: { de: '/docs/UniqSuite-Broschuere-DE.pdf', en: '/docs/UniqSuite-Brochure-EN.pdf' },
};
const order = lang === 'de' ? (['de', 'en'] as const) : (['en', 'de'] as const);

// Strukturierte Daten
const jsonld = [
  {
    '@context': 'https://schema.org', '@type': 'Organization', name: 'UniqSuite', url: SITE_URL,
    logo: `${SITE_URL}/favicon.svg`, email: CONTACT_EMAIL,
  },
  {
    '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'UniqSuite',
    applicationCategory: 'BusinessApplication', operatingSystem: 'Web', url: LOGIN_URL,
    inLanguage: ['de', 'en'], description: t.meta.description,
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage', inLanguage: lang,
    mainEntity: (lang === 'de' ? [
      ['Gibt es ein „NIS2-Zertifikat“?', 'Nein. Das Gesetz kennt keine allgemeine Zertifizierung. Eine ISO-27001-Zertifizierung ist ein starkes Indiz für ein funktionierendes ISMS, ersetzt aber nicht den Nachweis der gesetzlichen Pflichten.'],
      ['Wir sind ISO-27001-zertifiziert. Sind wir fertig?', 'Nicht automatisch. Prüfen Sie Geltungsbereich, Meldewesen, Registrierung, Pflichten der Leitung und Lieferkette.'],
      ['Wie lange dauert eine Gap-Analyse?', 'Das hängt von Größe und Vorarbeit ab. Ein erster vollständiger Durchgang ist bei guter Vorbereitung in wenigen Arbeitstagen machbar; die Vertiefung mit Nachweisen dauert länger.'],
      ['Wir sind eine Kommune. Gilt das BSIG für uns?', 'Für die Kommunalverwaltung gelten die Regelungen Ihres Landes. Kommunale Unternehmen können dagegen unmittelbar unter das BSIG fallen.'],
      ['Müssen wir alle Anforderungen sofort erfüllen?', 'Die Pflichten gelten seit Dezember 2025. Wer noch Lücken hat, braucht einen priorisierten, von der Leitung getragenen Plan – und muss ihn sichtbar abarbeiten.'],
      ['Was gilt, wenn wir auch KI einsetzen?', 'Der AI Act gilt unabhängig von NIS2. KI-Kompetenz und Verbote gelten bereits; ein KI-Register ist der erste sinnvolle Schritt. ISO 42001 bietet dafür das Managementsystem.'],
    ] : [
      ['Is there an “NIS2 certificate”?', 'No. The law knows no general certification. ISO 27001 certification is a strong indication of a working ISMS but does not replace evidence of the statutory obligations.'],
      ['We are ISO 27001 certified. Are we done?', 'Not automatically. Check scope, incident reporting, registration, management duties and the supply chain.'],
      ['How long does a gap analysis take?', 'That depends on size and prior work. With good preparation, a first complete pass is feasible in a few working days; the deep dive with evidence takes longer.'],
      ['We are a municipality. Does the BSI Act apply to us?', 'For the municipal administration, the rules of your German state apply. Municipal companies, however, may fall directly under the BSI Act.'],
      ['Do we have to meet all requirements immediately?', 'The obligations have applied since December 2025. If you still have gaps, you need a prioritised plan backed by management – and must visibly work through it.'],
      ['What if we also use AI?', 'The AI Act applies independently of NIS2. AI literacy and the prohibitions already apply; an AI register is the sensible first step. ISO 42001 provides the management system for it.'],
    ]).map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
];

// Daten für Skripte (nicht ausführbar → CSP-konform)
const clientData = {
  lang,
  login: loginHref(lang),
  demo: demoHref(lang),
  qc: t.qc,
  pdf: t.pdfText,
  fwNames: t.frameworks,
  data: qcData,
  seg: t.pdca.phases.map((p, i) => ({ n: p.n, title: p.title, img: p.img, href: stepHref(lang, i) })),
  qcBase: `/${lang}/quick-check/`,
  more: lang === 'de' ? 'Mehr zu diesem Schritt' : 'More about this step',
};
---
<Base lang={lang} path={`/${lang}/`} altPath={other} home jsonld={jsonld}>
  <Fragment slot="world">
    <picture>
      <source media="(max-width: 820px)" srcset={`${still('hero')}-m.webp`} type="image/webp" width="720" height="1280" />
      <img class="poster" src={`${still('hero')}-d.webp`} width="1600" height="900" alt="" fetchpriority="high" decoding="async" />
    </picture>
    <canvas data-world></canvas>
  </Fragment>

  <Fragment slot="labels">
    <div class="lbl3d lbl-ring" data-l="ring"><div class="gauge-num"><span data-count>59</span><small>%</small></div><span>{t.status.gaugeLabel}</span></div>
    {t.pdca.phases.map((p, i) => <div class="lbl3d lbl-seg" data-l={`seg-${i}`}><b>{p.n}</b><span>{p.title}</span></div>)}
    {t.deadlines.timers.map((x, i) => <div class={`lbl3d lbl-timer ${['fw-cra', 'fw-nis2', 'fw-iso27001'][i]}`} data-l={`timer-${i}`}><b>{x.value}</b><span>{x.label}</span></div>)}
    {t.deadlines.timeline.map((m, i) => <div class={`lbl3d lbl-ms fw-${m.fw}`} data-l={`ms-${i}`}><b>{m.date}</b> · {m.title}</div>)}
    {t.skyline.towers.map((x, i) => <div class={`lbl3d lbl-tower fw-${x.fw}`} data-l={`tower-${i}`}><b>{x.label}</b><span data-tower-val>{x.n}</span></div>)}
  </Fragment>

  <nav class="rail" slot="rail" aria-label={t.rail.label}>
    <ol>
      {Object.entries(t.rail.items).map(([k, v]) => (
        <li><a href={`#${k}`} data-rail={k}><span>{v}</span><i></i></a></li>
      ))}
    </ol>
  </nav>

  <!-- Start: was UniqSuite ist, auf einen Blick -->
  <section id="wolke" class="station hero" data-u0="5.85" data-u1="5.95" aria-labelledby="h-hero">
    <picture class="still" aria-hidden="true"><source media="(max-width: 820px)" srcset={`${still('hero')}-m.webp`} width="720" height="1280" /><img src={`${still('hero')}-d.webp`} alt="" loading="lazy" width="1600" height="900" /></picture>
    <div class="hero-step"><div class="wrap hero-grid">
      <div class="hero-inner">
        <p class="eyebrow">{t.hero.eyebrow}</p>
        <h1 id="h-hero" class="hero-h1" aria-label={`${t.hero.h1a} ${t.hero.h1b}`}>
          <span aria-hidden="true">{t.hero.h1a.split(' ').map((w) => <><span class="w"><span>{w}</span></span>{' '}</>)}</span>
          <span class="accent" aria-hidden="true">{t.hero.h1b.split(' ').map((w) => <><span class="w"><span>{w}</span></span>{' '}</>)}</span>
        </h1>
        <p class="lead">{t.hero.sub}</p>
        <div class="cta-row">
          <a class="btn btn-primary" href="#quick-check" data-magnetic>{t.hero.ctaCheck}<Icon name="arrow" /></a>
          <a class="btn btn-ghost" href={demoHref(lang)} data-anfrage data-magnetic>{t.nav.demo}</a>
        </div>
        <p class="cta-note">{t.hero.ctaNote}</p>
        <nav class="step-chips" aria-label={t.pdca.kicker}>
          <p>{t.hero.stepsLabel}</p>
          <ol>
            {t.pdca.phases.map((p, i) => <li><a href={stepHref(lang, i)}><b>{i + 1}</b>{p.title}</a></li>)}
          </ol>
        </nav>
      </div>
    </div></div>
  </section>

  <!-- Sechs Schritte: Liste bleibt stehen, beim Scrollen wird der jeweilige Schritt aktiv -->
  <section id="pdca" class="station steps" data-u0="5.95" data-u1="11.6" aria-labelledby="h-pdca">
    <picture class="still" aria-hidden="true"><source media="(max-width: 820px)" srcset={`${still('pdca')}-m.webp`} width="720" height="1280" /><img src={`${still('pdca')}-d.webp`} alt="" loading="lazy" width="1600" height="900" /></picture>
    <div class="steps-sticky"><div class="wrap"><div class="steps-panel" data-steps>
      <p class="kicker">{t.pdca.kicker}</p>
      <h2 id="h-pdca" class="h2">{t.pdca.h2a} <span class="accent">{t.pdca.h2b}</span></h2>
      <p class="steps-intro">{t.pdca.intro}</p>
      <ol class="phase-list">
        {t.pdca.phases.map((p, i) => (
          <li class="ph" data-ph={i}>
            <a class="ph-head" href={stepHref(lang, i)}><span class="ph-n">{p.n}</span><span class="ph-t">{p.title}</span><span class="ph-c">{p.cycle}</span></a>
            <div class="ph-body">
              <p>{p.text}</p>
              <p class="ph-res">{t.pdca.resultLabel}: <b>{p.result}</b></p>
              <a class="ph-more" href={stepHref(lang, i)}>{clientData.more}<Icon name="arrow" /></a>
              <figure class="shot">
                <picture>
                  <source srcset={pic(p.img, '').avif} sizes="(max-width: 820px) 92vw, 34rem" type="image/avif" />
                  <img src={pic(p.img, '').src} srcset={pic(p.img, '').webp} sizes="(max-width: 820px) 92vw, 34rem" width="800" height="500" loading="lazy" decoding="async" alt={`${p.title} – ${lang === 'de' ? 'Bildschirmansicht' : 'screenshot'}`} />
                </picture>
              </figure>
            </div>
          </li>
        ))}
      </ol>
      <p class="fine">{t.pdca.note}</p>
    </div></div></div>
    <div class="steps-track" aria-hidden="true">
      {t.pdca.phases.map((_, i) => <span class={`track-mark m${i + 1}`} id={`pdca-${i + 1}`}></span>)}
    </div>
  </section>

  <!-- Prinzip: einmal beantworten -->
  <section id="prinzip" class="station flow prinzip" data-u0="11.6" data-u1="11.8" data-dim="0.9" data-dim-m="0.95" aria-labelledby="h-prinzip">
    <div class="wrap prinzip-grid">
      <div>
        <p class="kicker">{t.convergence.kicker}</p>
        <h2 id="h-prinzip" data-split class="h2">{t.convergence.h2a} <span class="accent">{t.convergence.h2b}</span></h2>
        <p class="lead">{t.convergence.text}</p>
        <ol class="facts">
          {t.convergence.facts.map((f) => <li><strong data-countup={f.n}>{f.n}</strong><span>{f.text}</span></li>)}
        </ol>
        <p class="fine">{t.convergence.note}</p>
      </div>
      <figure class="prinzip-fig">
        <img src={`${still('konvergenz')}-d.webp`} width="1600" height="900" loading="lazy" decoding="async" alt={t.convergence.figAlt} />
      </figure>
    </div>
  </section>

  <!-- Funktionen -->
  <section id="funktionen" class="station flow features" data-u0="11.8" data-u1="12.2" data-dim="0.9" data-dim-m="0.95" aria-labelledby="h-feat">
    <div class="wrap">
      <p class="kicker">{t.features.kicker}</p>
      <h2 id="h-feat" data-split class="h2">{t.features.h2a} <span class="accent">{t.features.h2b}</span></h2>
      <div class="feat-grid">
        {t.features.items.map((f) => (
          <article class="card">
            <div class="txt"><p class="lbl">{f.label}</p><h3>{f.title}</h3><p>{f.text}</p></div>
            <picture>
              <source srcset={pic(f.key, '').avif} sizes="(max-width: 820px) 92vw, 30vw" type="image/avif" />
              <img src={pic(f.key, '').src} srcset={pic(f.key, '').webp} sizes="(max-width: 820px) 92vw, 30vw" width="800" height="500" loading="lazy" decoding="async" alt={`${f.label} – ${lang === 'de' ? 'Bildschirmansicht, Demo-Mandant' : 'screenshot, demo tenant'}`} />
            </picture>
          </article>
        ))}
      </div>
      <p class="reports"><Icon name="file" />{t.features.reports}</p>
    </div>
  </section>

  <!-- Fristen -->
  <section id="fristen" class="station" data-u0="12.2" data-u1="18" aria-labelledby="h-dead">
    <picture class="still" aria-hidden="true"><source media="(max-width: 820px)" srcset={`${still('fristen')}-m.webp`} width="720" height="1280" /><img src={`${still('fristen')}-d.webp`} alt="" loading="lazy" width="1600" height="900" /></picture>
    <div class="step"><div class="wrap"><div class="panel">
      <p class="kicker">{t.deadlines.kicker}</p>
      <h2 id="h-dead" data-split class="h2">{t.deadlines.h2a} <span class="accent">{t.deadlines.h2b}</span></h2>
      <p class="lead">{t.deadlines.intro}</p>
      <h3 class="res-h">{t.deadlines.timersTitle}</h3>
      <div class="timers">
        {t.deadlines.timers.map((x, i) => (
          <p class={`timer ${['fw-cra', 'fw-nis2', 'fw-iso27001'][i]}`}><b>{x.value}</b><span>{x.label}<small>{x.sub}</small></span></p>
        ))}
      </div>
      <p class="fine">{t.deadlines.timersNote}</p>
    </div></div></div>
    {msGroups.map(([a, b], gi) => (
      <div class="step" id={gi === 0 ? 'zeitachse' : undefined}><div class="wrap"><div class="panel">
        {gi === 0 && <h3 class="res-h">{t.deadlines.timelineTitle}</h3>}
        <ol class="timeline" start={a + 1}>
          {t.deadlines.timeline.slice(a, b).map((m, j) => (
            <li class={`milestone fw-${m.fw}`} data-ms={a + j}>
              <time>{m.date}</time>
              <div><h3>{m.title}</h3><p>{m.text}</p></div>
            </li>
          ))}
        </ol>
        {gi === msGroups.length - 1 && <p class="source">{t.deadlines.source}</p>}
      </div></div></div>
    ))}
  </section>

  <!-- Quick-Check: Regelwerk wählen, öffnet in neuem Tab -->
  <section id="quick-check" class="station qc" data-u0="18" data-u1="20" data-dim="0.72" data-dim-m="0.85" aria-labelledby="h-qc">
    <picture class="still" aria-hidden="true"><source media="(max-width: 820px)" srcset={`${still('regelwerke')}-m.webp`} width="720" height="1280" /><img src={`${still('regelwerke')}-d.webp`} alt="" loading="lazy" width="1600" height="900" /></picture>
    <div class="wrap qc-wrap">
      <div class="qc-shell">
        <p class="kicker">{t.qc.kicker}</p>
        <h2 id="h-qc" data-split class="h2">{t.qc.h2a} <span class="accent">{t.qc.h2b}</span></h2>
        <p class="lead">{t.qc.intro}</p>
        <p class="privacy"><Icon name="eye" />{t.qc.privacy}</p>
      </div>
      <div class="carousel" data-carousel>
        <p class="carousel-hint" id="qc-hint">{t.qc.pickHint}</p>
        <ul class="ring" aria-describedby="qc-hint">
          {FW.map((f, i) => {
            const fw = qcData.frameworks.find((x) => x.id === f)!;
            const tw = t.skyline.towers.find((x) => x.fw === f)!;
            return (
              <li class={`ring-item fw-${f} r${i}`}>
                <a href={`/${lang}/quick-check/${f}/`} target="_blank" rel="noopener">
                  <i></i>
                  <b>{fw.name[lang]}</b>
                  <span>{t.qc.questionsCount.replace('{n}', String(fw.questions.length))}</span>
                  <small>{f === 'cra' ? t.qc.craNote : `${tw.n} ${t.qc.reqLabel}`}</small>
                  <em>{t.qc.open}<Icon name="ext" /></em>
                </a>
              </li>
            );
          })}
        </ul>
        <div class="carousel-nav">
          <button type="button" class="prev" data-car="-1" aria-label={lang === 'de' ? 'Vorheriges Regelwerk' : 'Previous framework'}><Icon name="arrow" /></button>
          <button type="button" class="next" data-car="1" aria-label={lang === 'de' ? 'Nächstes Regelwerk' : 'Next framework'}><Icon name="arrow" /></button>
        </div>
      </div>
    </div>
  </section>

  <div class="solid" data-dim="0.96">
    <!-- Vertrauen -->
    <section id="vertrauen" class="trust" aria-labelledby="h-trust">
      <div class="wrap">
        <p class="kicker">{t.trust.kicker}</p>
        <h2 id="h-trust" data-split class="h2">{t.trust.h2a} <span class="accent">{t.trust.h2b}</span></h2>
        <ul class="trust-list">
          {t.trust.items.map((x) => (
            <li><h3>{x.title}</h3><p>{x.text}</p></li>
          ))}
        </ul>
        <div class="honest">
          <div><p class="kicker">{t.trust.honestKicker}</p><h3>{t.trust.honestTitle}</h3></div>
          <div><p>{t.trust.honestIntro}</p><ul>{t.trust.honest.map((h) => <li>{h}</li>)}</ul></div>
        </div>
      </div>
    </section>

    <!-- Downloads: White Paper und Broschüre -->
    <section id="downloads" class="downloads" aria-labelledby="h-dl">
      <div class="wrap">
        <p class="kicker">{t.whitepaper.kicker}</p>
        <h2 id="h-dl" data-split class="h2">{t.whitepaper.h2a} <span class="accent">{t.whitepaper.h2b}</span></h2>
        <p class="lead">{t.whitepaper.intro}</p>
        <div class="dl-grid">
          <article class="dl-card">
            <div class="dl-cover"><img src={`/img/wp-cover-${lang}.webp`} width="420" height="594" loading="lazy" decoding="async" alt="" /></div>
            <div class="dl-txt">
              <p class="dl-meta">{t.whitepaper.meta}</p>
              <h3>{t.whitepaper.title}</h3>
              <p>{t.whitepaper.text}</p>
              <div class="dl-btns">
                {order.map((l, i) => <a class={`btn ${i === 0 ? 'btn-primary' : 'btn-ghost'}`} href={docs.wp[l]} hreflang={l} download><Icon name="download" />{t.whitepaper[l]}</a>)}
              </div>
            </div>
          </article>
          <article class="dl-card">
            <div class="dl-cover"><img src={`/img/br-cover-${lang}.webp`} width="420" height="594" loading="lazy" decoding="async" alt="" /></div>
            <div class="dl-txt">
              <p class="dl-meta">{t.whitepaper.bMeta}</p>
              <h3>{t.whitepaper.bTitle}</h3>
              <p>{t.whitepaper.bText}</p>
              <div class="dl-btns">
                {order.map((l, i) => <a class={`btn ${i === 0 ? 'btn-primary' : 'btn-ghost'}`} href={docs.br[l]} hreflang={l} download><Icon name="download" />{t.whitepaper[l]}</a>)}
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- Schluss -->
    <section class="final" aria-labelledby="h-final">
      <div class="wrap">
        <h2 id="h-final" data-split>{t.final.h2a} <span class="accent">{t.final.h2b}</span></h2>
        <p>{t.final.text}</p>
        <div class="cta-row">
          <a class="btn btn-primary" href={demoHref(lang)} data-anfrage data-magnetic>{t.nav.demo}<Icon name="arrow" /></a>
          <a class="btn btn-ghost" href={loginHref(lang)} data-magnetic><Icon name="login" />{t.nav.login}</a>
        </div>
      </div>
    </section>
  </div>

  <script type="application/json" id="uq-data" is:inline set:html={JSON.stringify(clientData)} />
</Base>
