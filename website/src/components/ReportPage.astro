---
/**
 * Seite zu einem Bericht: was er enthält (Kapitel in Reihenfolge), wofür man ihn braucht, Formate, FAQ.
 * Oben zwei Berichtsseiten als Grafik (Deckblatt und Inhaltsseite), die beim Laden aufgefächert werden.
 */
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import ReportSheet from './ReportSheet.astro';
import { demoHref, SITE_URL, type Lang } from '../config';
import { reports, reportsUi, reportHref, reportHub, reportOrder, formatLabel, type RepKey } from '../data/reports';
import { steps, stepHref } from '../data/steps';
import { topics, topicHref } from '../data/topics';
import { features, featureHref } from '../data/features';
import de from '../i18n/de';
import en from '../i18n/en';

interface Props { lang: Lang; k: RepKey }
const { lang, k } = Astro.props;
const t = lang === 'de' ? de : en;
const ui = reportsUi[lang];
const list = reports[lang];
const r = list.find((x) => x.key === k)!;
const other = lang === 'de' ? 'en' : 'de';
const path = reportHref(lang, k);
const L = lang === 'de'
  ? { kicker: 'Bericht', what: 'Worum es geht', uses: 'Wofür Sie ihn brauchen', toc: 'Was im Bericht steht', formats: 'Formate', brand: 'Mit Ihrem Firmennamen, im PDF auch mit Logo, auf Deutsch oder Englisch.', faq: 'Häufige Fragen', more: 'Weitere Berichte', related: 'Passend dazu', step: 'Schritt', topic: 'Wissen', feature: 'Funktion', ctaH: 'Sehen Sie Ihre eigenen Berichte.', ctaT: 'In einer halben Stunde zeigen wir Ihnen, wie die Berichte aus Ihren Daten entstehen.', home: 'Startseite', hub: 'Berichte', note: 'Die Grafiken zeigen Beispielwerte.' }
  : { kicker: 'Report', what: 'What it is about', uses: 'What you need it for', toc: 'What the report contains', formats: 'Formats', brand: 'With your company name, in the PDF also with your logo, in German or English.', faq: 'Frequently asked questions', more: 'More reports', related: 'Related', step: 'Step', topic: 'Knowledge', feature: 'Feature', ctaH: 'See your own reports.', ctaT: 'In half an hour we show you how the reports are built from your data.', home: 'Home', hub: 'Reports', note: 'The graphics show sample values.' };
const tp = r.topic ? topics[lang].find((x) => x.key === r.topic) : undefined;
const related = [
  ...(r.step !== undefined ? [{ href: stepHref(lang, r.step), k: `${L.step} ${r.step + 1}`, n: steps[lang][r.step].title }] : []),
  ...(tp ? [{ href: topicHref(lang, tp.key), k: L.topic, n: tp.name }] : []),
  ...(r.feature !== undefined ? [{ href: featureHref(lang, r.feature), k: L.feature, n: features[lang][r.feature].title }] : []),
];
const url = (p: string) => new URL(p, SITE_URL).href;
const jsonld = [
  { '@context': 'https://schema.org', '@type': 'WebPage', name: `${r.title}: ${r.sub}`, description: r.lead, inLanguage: lang, url: url(path), isPartOf: { '@type': 'WebSite', name: 'UniqSuite', url: url(`/${lang}/`) }, about: { '@type': 'Thing', name: r.title }, hasPart: r.chapters.map((c) => ({ '@type': 'WebPageElement', name: c.h, description: c.t })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: L.home, item: url(`/${lang}/`) },
    { '@type': 'ListItem', position: 2, name: L.hub, item: url(reportHub(lang)) },
    { '@type': 'ListItem', position: 3, name: r.title, item: url(path) },
  ] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: r.faq.map((x) => ({ '@type': 'Question', name: x.q, acceptedAnswer: { '@type': 'Answer', text: x.a } })) },
];
---
<Base lang={lang} path={path} altPath={reportHref(other, k)} title={`${r.title}: ${r.sub.replace(/\.$/, '')} – UniqSuite`} description={r.lead} jsonld={jsonld}>
  <Fragment slot="world">
    <picture>
      <source media="(max-width: 820px)" srcset="/img/still/pdca-m.webp" type="image/webp" width="720" height="1280" />
      <img class="poster sub" src="/img/still/pdca-d.webp" width="1600" height="900" alt="" decoding="async" />
    </picture>
  </Fragment>

  <article class={`sp fwp rpp rp-${k}`}>
    <nav class="wrap fwp-nav" aria-label={L.hub}>
      {reportOrder.map((x) => <a href={reportHref(lang, x)} aria-current={x === k ? 'page' : undefined}><i></i>{list.find((y) => y.key === x)!.name}</a>)}
    </nav>

    <header class="wrap fwp-head rp-head">
      <div>
        <p class="kicker">{L.kicker} · {r.formats.map((f) => formatLabel[f]).join(' · ')}</p>
        <h1>{r.title} <span class="accent">{r.sub}</span></h1>
        <p class="lead">{r.lead}</p>
      </div>
      <div class="rp-stack">
        <div class="rp-s rp-s1"><ReportSheet k={k} lang={lang} variant="cover" /></div>
        <div class="rp-s rp-s2"><ReportSheet k={k} lang={lang} /></div>
      </div>
    </header>

    <section class="wrap sp-block rp-intro" aria-labelledby="rp-what">
      <div>
        <h2 id="rp-what" class="sp-h">{L.what}</h2>
        <p>{r.what}</p>
      </div>
      <div>
        <h2 class="sp-h">{L.uses}</h2>
        <ul class="fwp-list">{r.uses.map((x) => <li><Icon name="check" /><span>{x}</span></li>)}</ul>
      </div>
    </section>

    <section class="wrap sp-block" aria-labelledby="rp-toc">
      <h2 id="rp-toc" class="sp-h">{L.toc}</h2>
      <ol class="rp-toc">
        {r.chapters.map((c, i) => <li><span class="rp-n">{String(i + 1).padStart(2, '0')}</span><div><h3>{c.h}</h3><p>{c.t}</p></div></li>)}
      </ol>
    </section>

    <section class="wrap sp-block rp-fmt" aria-labelledby="rp-fmt">
      <div>
        <h2 id="rp-fmt" class="sp-h">{L.formats}</h2>
        <ul class="rp-badges">{r.formats.map((f) => <li class={`fmt-${f}`}><Icon name="file" /><b>{formatLabel[f]}</b></li>)}</ul>
        <p class="rp-brand">{L.brand}</p>
      </div>
      <div class="rp-extra">
        <h3>{r.extra.h}</h3>
        <p>{r.extra.t}</p>
      </div>
    </section>

    {related.length > 0 && (
      <nav class="wrap sp-block" aria-labelledby="rp-rel">
        <h2 id="rp-rel" class="sp-h">{L.related}</h2>
        <ul class="rp-rel">{related.map((x) => <li><a href={x.href}><small>{x.k}</small><b>{x.n}</b><Icon name="arrow" /></a></li>)}</ul>
      </nav>
    )}

    <section class="wrap sp-block" aria-labelledby="rp-faq">
      <h2 id="rp-faq" class="sp-h">{L.faq}</h2>
      <div class="fwp-faq">
        {r.faq.map((x, i) => <details open={i === 0}><summary>{x.q}<Icon name="down" /></summary><p>{x.a}</p></details>)}
      </div>
    </section>

    <nav class="wrap sp-block" aria-labelledby="rp-more">
      <h2 id="rp-more" class="sp-h">{L.more}</h2>
      <ul class="rp-more">
        {reportOrder.filter((x) => x !== k).map((x) => {
          const o = list.find((y) => y.key === x)!;
          return <li><a href={reportHref(lang, x)}><span class="rp-mini"><ReportSheet k={x} lang={lang} /></span><b>{o.title}</b><span>{o.sub}</span></a></li>;
        })}
      </ul>
    </nav>

    <section class="wrap sp-cta">
      <h2>{L.ctaH}</h2>
      <p>{L.ctaT}</p>
      <div class="cta-row">
        <a class="btn btn-primary" href={demoHref(lang)} data-anfrage>{t.nav.demo}<Icon name="arrow" /></a>
      </div>
    </section>

    <footer class="wrap fwp-src"><p>{L.note}</p></footer>
  </article>
</Base>
