---
/**
 * Seite zu einem der sechs Schritte. Gleicher Stil wie die Startseite:
 * gedimmtes Standbild der 3D-Szene als Hintergrund, Ring als Navigation.
 */
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import Viz from './Viz.astro';
import { photos, photoSrc } from '../data/photos';
import { demoHref, type Lang } from '../config';
import { steps, stepHref } from '../data/steps';
import de from '../i18n/de';
import en from '../i18n/en';

interface Props { lang: Lang; index: number }
const { lang, index } = Astro.props;
const t = lang === 'de' ? de : en;
const list = steps[lang];
const s = list[index];
const other = lang === 'de' ? 'en' : 'de';
const path = stepHref(lang, index);
const altPath = stepHref(other, index);
const L = lang === 'de'
  ? { of: 'Schritt {i} von 6', why: 'Worum es geht', how: 'So gehen Sie vor', tool: 'Was UniqSuite Ihnen abnimmt', result: 'Am Ende haben Sie', refs: 'Bezug zu den Regelwerken', prev: 'Vorheriger Schritt', next: 'Nächster Schritt', all: 'Alle sechs Schritte', ring: 'Die sechs Schritte', note: 'Bildschirmfoto aus einem Demo-Mandanten mit erfundenen Daten.', ctaH: 'Wie weit sind Sie bei diesem Schritt?', ctaT: 'Der Quick-Check zeigt es in zwei Minuten. Oder Sie lassen sich UniqSuite mit Ihren eigenen Fragen zeigen.', refsNote: 'Die Bezüge zeigen, wo die Anforderungen herkommen. Sie ersetzen keine rechtliche Prüfung.' }
  : { of: 'Step {i} of 6', why: 'What it is about', how: 'How you go about it', tool: 'What UniqSuite does for you', result: 'What you end up with', refs: 'Where the requirements come from', prev: 'Previous step', next: 'Next step', all: 'All six steps', ring: 'The six steps', note: 'Screenshot from a demo tenant with made-up data.', ctaH: 'How far along are you with this step?', ctaT: 'The quick check shows you in two minutes. Or let us show you UniqSuite with your own questions.', refsNote: 'The references show where the requirements come from. They do not replace a legal assessment.' };
const ph = photos[(['briefing', 'it', 'collab', 'strategy', 'break', 'audit'] as const)[index]];
const shot = (n: string) => `/img/shots/${lang}-${n}`;
const prev = index > 0 ? index - 1 : null;
const next = index < list.length - 1 ? index + 1 : null;

// Ring aus sechs Bogensegmenten (SVG), wie in der 3D-Szene
const R = 46, C = 60, GAP = 7;
const arc = (k: number) => {
  const a0 = ((k * 60 - 90 + GAP / 2) * Math.PI) / 180;
  const a1 = (((k + 1) * 60 - 90 - GAP / 2) * Math.PI) / 180;
  const p = (a: number) => `${(C + R * Math.cos(a)).toFixed(2)} ${(C + R * Math.sin(a)).toFixed(2)}`;
  return `M ${p(a0)} A ${R} ${R} 0 0 1 ${p(a1)}`;
};
const lbl = (k: number) => {
  const a = (((k + 0.5) * 60 - 90) * Math.PI) / 180;
  return { x: (C + (R + 0.5) * Math.cos(a)).toFixed(1), y: (C + (R + 0.5) * Math.sin(a) + 3.6).toFixed(1) };
};
const jsonld = [{
  '@context': 'https://schema.org', '@type': 'HowToStep', name: s.title, text: s.lead, position: index + 1,
}];
---
<Base lang={lang} path={path} altPath={altPath} title={`${s.title} – ${L.of.replace('{i}', String(index + 1))} – UniqSuite`} description={s.lead} jsonld={jsonld}>
  <Fragment slot="world">
    <picture>
      <source media="(max-width: 820px)" srcset="/img/still/pdca-m.webp" type="image/webp" width="720" height="1280" />
      <img class="poster sub" src="/img/still/pdca-d.webp" width="1600" height="900" alt="" decoding="async" />
    </picture>
  </Fragment>

  <article class="sp">
    <header class="wrap sp-head">
      <nav class="sp-ring" aria-label={L.ring}>
        <svg viewBox="0 0 120 120" role="img" aria-label={L.ring}>
          {list.map((x, k) => (
            <a href={stepHref(lang, k)} aria-label={`${k + 1}. ${x.title}`} aria-current={k === index ? 'page' : undefined}>
              <path class={`seg${k === index ? ' on' : ''}`} d={arc(k)} />
              <text x={lbl(k).x} y={lbl(k).y} class={k === index ? 'on' : ''}>{k + 1}</text>
            </a>
          ))}
        </svg>
        <span class="sp-ring-c"><b>{index + 1}</b>/6</span>
      </nav>
      <div>
        <p class="kicker">{L.of.replace('{i}', String(index + 1))} · {s.cycle}</p>
        <h1>{s.title} <span class="accent">{s.sub}</span></h1>
        <p class="lead">{s.lead}</p>
      </div>
    </header>

    <!-- 1 · Worum es geht, daneben die Grafik zum Schritt -->
    <section class="wrap sp-block sp-intro" data-rv>
      <div class="sp-body">
        <h2>{L.why}</h2>
        <p>{s.why}</p>
      </div>
      <Viz kind={s.img} lang={lang} kicker={`${L.of.replace('{i}', String(index + 1))}`} title={s.title} />
    </section>

    <!-- 2 · Vorgehen als Abfolge -->
    <section class="wrap sp-block" data-rv>
      <h2 class="sp-h">{L.how}</h2>
      <ol class="sp-flow">{s.how.map((x) => <li><p>{x}</p></li>)}</ol>
    </section>

    <!-- Szenenbild: bewegt sich beim Scrollen leicht -->
    <figure class="wrap sp-block photo-band" data-rv>
      <img src={photoSrc(ph).src} srcset={photoSrc(ph).srcset} sizes="(max-width: 1360px) 100vw, 1360px" width={ph.w} height={ph.h} loading="lazy" decoding="async" alt={ph.alt[lang]} />
    </figure>

    <!-- 3 · Bildschirmfoto mit Bewegung beim Scrollen, daneben was die Software übernimmt -->
    <section class="wrap sp-block sp-tool-grid" data-rv>
      <figure class="sp-shot-wide">
        <div class="frame">
          <picture>
            <source srcset={`${shot(s.img)}-800.avif 800w, ${shot(s.img)}-1600.avif 1600w`} sizes="(max-width: 980px) 92vw, 60vw" type="image/avif" />
            <img src={`${shot(s.img)}-1600.webp`} srcset={`${shot(s.img)}-800.webp 800w, ${shot(s.img)}-1600.webp 1600w`} sizes="(max-width: 980px) 92vw, 60vw" width="1600" height="1000" loading="lazy" decoding="async" alt={`${s.title} – ${lang === 'de' ? 'Bildschirmansicht in UniqSuite' : 'screen in UniqSuite'}`} />
          </picture>
        </div>
        <figcaption>{L.note}</figcaption>
      </figure>
      <div class="sp-body">
        <h2>{L.tool}</h2>
        <ul class="sp-tool">{s.tool.map((x) => <li>{x}</li>)}</ul>
      </div>
    </section>

    <!-- 4 · Ergebnis als großes Statement -->
    <section class="wrap sp-block" data-rv>
      <div class="sp-result-band">
        <p class="kicker">{L.result}</p>
        <p class="sp-big">{s.result.charAt(0).toUpperCase() + s.result.slice(1)}</p>
      </div>
    </section>

    <!-- 5 · Bezüge als Karten -->
    <section class="wrap sp-block" data-rv>
      <h2 class="sp-h">{L.refs}</h2>
      <ul class="sp-refs-grid">{s.refs.map((x) => <li>{x}</li>)}</ul>
      <p class="fine">{L.refsNote}</p>
    </section>

    <nav class="wrap sp-pager" aria-label={L.all}>
      {prev !== null
        ? <a class="pg prev" href={stepHref(lang, prev)} rel="prev"><span>{L.prev}</span><b>{prev + 1}. {list[prev].title}</b></a>
        : <a class="pg prev" href={`/${lang}/#pdca`}><span>{L.all}</span><b>{t.pdca.h2a} {t.pdca.h2b}</b></a>}
      {next !== null
        ? <a class="pg next" href={stepHref(lang, next)} rel="next"><span>{L.next}</span><b>{next + 1}. {list[next].title}</b></a>
        : <a class="pg next" href={`/${lang}/#pdca`}><span>{L.all}</span><b>{t.pdca.h2a} {t.pdca.h2b}</b></a>}
    </nav>

    <section class="wrap sp-cta">
      <h2>{L.ctaH}</h2>
      <p>{L.ctaT}</p>
      <div class="cta-row">
        <a class="btn btn-primary" href={`/${lang}/#quick-check`}>{t.hero.ctaCheck}<Icon name="arrow" /></a>
        <a class="btn btn-ghost" href={demoHref(lang)} data-anfrage>{t.nav.demo}</a>
      </div>
    </section>
  </article>
</Base>
