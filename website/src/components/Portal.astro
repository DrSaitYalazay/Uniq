---
/**
 * Leuchtender Ring wie die Fristen-Ringe in der 3D-Szene: ein umlaufender Lichtbogen,
 * ein gegenläufiger Innenring und kreisende Lichtpunkte. Farbe kommt über --c (Klasse am Elternteil).
 * Inhalt (Zahl oder Symbol) über den Slot.
 */
interface Props { size?: 'sm' | 'lg'; glyph?: string }
const { size = 'sm', glyph } = Astro.props;
// Symbole für die Funktionen, einfache Linien (24er Raster)
const G: Record<string, string> = {
