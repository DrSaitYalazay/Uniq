  treat: '<path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"/><path d="M12 8v7M9 12l3 3 3-3"/>',
  soa: '<path d="M6 3h9l4 4v14H6z"/><path d="M15 3v4h4"/><path d="M9 14l2 2 4-4"/>',
  audit: '<circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5L21 21"/><path d="M8 10.5l1.8 1.8 3.2-3.3"/>',
  review: '<rect x="3" y="4" width="18" height="12" rx="1.5"/><path d="M8 20l4-4 4 4"/><path d="M7 12l3-3 3 2 4-4"/>',

};
---
<span class={`portal portal-${size}`} aria-hidden="true">
  <span class="pg"><span class="arc"></span></span>
  <span class="ring2"></span>
  <span class="dots"></span>
  <span class="core">{glyph ? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={G[glyph]} /> : <slot />}</span>
</span>
