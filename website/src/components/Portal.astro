---
/**
 * Leuchtender Ring wie die Fristen-Ringe in der 3D-Szene: ein umlaufender Lichtbogen,
 * ein gegenläufiger Innenring und kreisende Lichtpunkte. Farbe kommt über --c (Klasse am Elternteil).
 * Inhalt (Zahl oder Symbol) über den Slot.
 */
interface Props { size?: 'sm' | 'lg'; glyph?: string }
const { size = 'sm', glyph } = Astro.props;
// Symbole für die Funktionen, einfache Linien (24er Raster)
const G: Record<string, string> = {
  dashboard: '<path d="M4 15a8 8 0 0 1 16 0"/><path d="M12 15l4-5"/><circle cx="12" cy="15" r="1.4"/>',
  incident: '<path d="M12 3l9 16H3z"/><path d="M12 10v4"/><circle cx="12" cy="16.6" r="0.6"/>',
  supplier: '<circle cx="5" cy="12" r="2.4"/><circle cx="19" cy="6" r="2.4"/><circle cx="19" cy="18" r="2.4"/><path d="M7.2 11l9.6-4M7.2 13l9.6 4"/>',
  policies: '<path d="M6 3h9l4 4v14H6z"/><path d="M15 3v4h4"/><path d="M9 12h7M9 15.5h7M9 9h3"/>',
  ai: '<rect x="6" y="6" width="12" height="12" rx="2.5"/><path d="M10 10h4v4h-4z"/><path d="M9 3v3M15 3v3M9 18v3M15 18v3M3 9h3M3 15h3M18 9h3M18 15h3"/>',
  evidence: '<path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"/><path d="M8.6 12.2l2.4 2.4 4.6-4.8"/>',
};
---
<span class={`portal portal-${size}`} aria-hidden="true">
  <span class="pg"><span class="arc"></span></span>
  <span class="ring2"></span>
  <span class="dots"></span>
  <span class="core">{glyph ? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={G[glyph]} /> : <slot />}</span>
</span>
