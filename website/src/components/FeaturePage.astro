---
/**
 * Seite zu einer Funktion. Gleicher Aufbau wie die Schrittseiten:
 * gedimmtes Standbild als Hintergrund, Ring aus sechs Segmenten als Navigation.
 */
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import { demoHref, type Lang } from '../config';
import { features, featureHref } from '../data/features';
import { steps, stepHref } from '../data/steps';
import de from '../i18n/de';
import en from '../i18n/en';

interface Props { lang: Lang; index: number }
const { lang, index } = Astro.props;
const t = lang === 'de' ? de : en;
const list = features[lang];
const f = list[index];
const other = lang === 'de' ? 'en' : 'de';
const path = featureHref(lang, index);
const altPath = featureHref(other, index);
const L = lang === 'de'
  ? { of: 'Funktion {i} von 6', why: 'Worum es geht', can: 'Was Sie damit tun', gain: 'Was Sie davon haben', steps: 'Gehört zu diesen Schritten', step: 'Schritt', refs: 'Bezug zu den Regelwerken', prev: 'Vorherige Funktion', next: 'Nächste Funktion', all: 'Alle Funktionen', ring: 'Die sechs Funktionen', note: 'Bildschirmfoto aus einem Demo-Mandanten mit erfundenen Daten.', ctaH: 'Sehen Sie sich das mit Ihren eigenen Fragen an.', ctaT: 'In einer halben Stunde zeigen wir Ihnen, wie diese Funktion in Ihrem Alltag aussieht. Oder Sie prüfen vorher im Quick-Check, wo Sie stehen.', refsNote: 'Die Bezüge zeigen, wo die Anforderungen herkommen. Sie ersetzen keine rechtliche Prüfung.' }
  : { of: 'Feature {i} of 6', why: 'What it is about', can: 'What you do with it', gain: 'What you get out of it', steps: 'Part of these steps', step: 'Step', refs: 'Where the requirements come from', prev: 'Previous feature', next: 'Next feature', all: 'All features', ring: 'The six features', note: 'Screenshot from a demo tenant with made-up data.', ctaH: 'See it with your own questions.', ctaT: 'In half an hour we show you what this feature looks like in your day-to-day work. Or check first where you stand with the quick check.', refsNote: 'The references show where the requirements come from. They do not replace a legal assessment.' };
const shot = (n: string) => `/img/shots/${lang}-${n}`;
const prev = (index + list.length - 1) % list.length;
const next = (index + 1) % list.length;

// Ring aus sechs Bogensegmenten (SVG), wie bei den Schritten
const R = 46, C = 60, GAP = 7;
const arc = (k: number) => {
  const a0 = ((k * 60 - 90 + GAP / 2) * Math.PI) / 180;
  const a1 = (((k + 1) * 60 - 90 - GAP / 2) * Math.PI) / 180;
  const p = (a: number) => `${(C + R * Math.cos(a)).toFixed(2)} ${(C + R * Math.sin(a)).toFixed(2)}`;
  return `M ${p(a0)} A ${R} ${R} 0 0 1 ${p(a1)}`;
};
const jsonld = [{
  '@context': 'https://schema.org', '@type': 'WebPage', name: `${f.label}: ${f.title}`, description: f.lead,
  isPartOf: { '@type': 'WebSite', name: 'UniqSuite' },
}];
---
<Base lang={lang} path={path} altPath={altPath} title={`${f.title.toLowerCase().includes(f.label.toLowerCase()) ? f.title : `${f.label}: ${f.title}`} – UniqSuite`} description={f.lead} jsonld={jsonld}>
  <Fragment slot="world">
    <picture>
      <source media="(max-width: 820px)" srcset="/img/still/konvergenz-m.webp" type="image/webp" width="720" height="1280" />
      <img class="poster sub" src="/img/still/konvergenz-d.webp" width="1600" height="900" alt="" decoding="async" />
    </picture>
  </Fragment>

  <article class={`sp fp ft-${index}`}>
    <header class="wrap sp-head">
      <nav class="sp-ring" aria-label={L.ring}>
        <svg viewBox="0 0 120 120" role="img" aria-label={L.ring}>
          {list.map((x, k) => (
            <a href={featureHref(lang, k)} aria-label={x.label} aria-current={k === index ? 'page' : undefined}>
              <title>{x.label}</title>
              <path class={`seg ft-${k}${k === index ? ' on' : ''}`} d={arc(k)} />
            </a>
          ))}
        </svg>
        <span class="sp-ring-c fp-c">{f.label}</span>
      </nav>
      <div>
        <p class="kicker">{L.of.replace('{i}', String(index + 1))} · {f.label}</p>
        <h1>{f.title} <span class="accent">{f.sub}</span></h1>
        <p class="lead">{f.lead}</p>
      </div>
    </header>

    <div class="wrap sp-grid">
      <figure class="sp-shot">
        <div class="frame">
          <picture>
            <source srcset={`${shot(f.img)}-800.avif 800w, ${shot(f.img)}-1600.avif 1600w`} sizes="(max-width: 980px) 92vw, 52vw" type="image/avif" />
            <img src={`${shot(f.img)}-1600.webp`} srcset={`${shot(f.img)}-800.webp 800w, ${shot(f.img)}-1600.webp 1600w`} sizes="(max-width: 980px) 92vw, 52vw" width="1600" height="1000" decoding="async" alt={`${f.label} – ${lang === 'de' ? 'Bildschirmansicht in UniqSuite' : 'screen in UniqSuite'}`} />
          </picture>
        </div>
        <figcaption>{L.note}</figcaption>
      </figure>

      <div class="sp-body">
        <section>
          <h2>{L.why}</h2>
          <p>{f.why}</p>
        </section>
        <section>
          <h2>{L.can}</h2>
          <ul class="sp-tool">{f.can.map((x) => <li>{x}</li>)}</ul>
        </section>
        <div class="sp-result">
          <p class="kicker">{L.gain}</p>
          <ul class="fp-gain">{f.gain.map((x) => <li>{x}</li>)}</ul>
        </div>
        <section>
          <h2>{L.steps}</h2>
          <ul class="fp-steps">
            {f.steps.map((k) => (
              <li><a href={stepHref(lang, k)}><span>{L.step} {k + 1}</span><b>{steps[lang][k].title}</b><Icon name="arrow" /></a></li>
            ))}
          </ul>
        </section>
        <section>
          <h2>{L.refs}</h2>
          <ul class="sp-refs">{f.refs.map((x) => <li>{x}</li>)}</ul>
          <p class="fine">{L.refsNote}</p>
        </section>
      </div>
    </div>

    <nav class="wrap sp-pager" aria-label={L.all}>
      <a class="pg prev" href={featureHref(lang, prev)} rel="prev"><span>{L.prev}</span><b>{list[prev].label}</b></a>
      <a class="pg next" href={featureHref(lang, next)} rel="next"><span>{L.next}</span><b>{list[next].label}</b></a>
    </nav>

    <section class="wrap sp-cta">
      <h2>{L.ctaH}</h2>
      <p>{L.ctaT}</p>
      <div class="cta-row">
        <a class="btn btn-primary" href={demoHref(lang)} data-anfrage>{t.nav.demo}<Icon name="arrow" /></a>
        <a class="btn btn-ghost" href={`/${lang}/#quick-check`}>{t.hero.ctaCheck}</a>
      </div>
    </section>
  </article>
</Base>
