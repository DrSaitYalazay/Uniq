---
import TopicPage from '../../../components/TopicPage.astro';
import { topics, topicSlug } from '../../../data/topics';
export function getStaticPaths() {
  return topics.en.map((t) => ({ params: { slug: topicSlug('en', t.key) }, props: { k: t.key } }));
}
const { k } = Astro.props;
---
<TopicPage lang="en" k={k} />
