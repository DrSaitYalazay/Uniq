---
import ReportPage from '../../../components/ReportPage.astro';
import { reports, reportSlug } from '../../../data/reports';
export function getStaticPaths() {
  return reports.en.map((r) => ({ params: { slug: reportSlug('en', r.key) }, props: { k: r.key } }));
}
const { k } = Astro.props;
---
<ReportPage lang="en" k={k} />
