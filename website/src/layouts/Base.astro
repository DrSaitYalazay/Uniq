---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import { SITE_URL, loginHref, demoHref, CONTACT_EMAIL, type Lang } from '../config';
import de from '../i18n/de';
import en from '../i18n/en';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Pfad dieser Seite, z. B. /de/ */
  path: string;
  /** Pfad der Seite in der anderen Sprache */
  altPath: string;
  home?: boolean;
  jsonld?: object[];
  noindex?: boolean;
}
const { lang, path, altPath, home = false, jsonld = [], noindex = false } = Astro.props;
const t = lang === 'de' ? de : en;
const title = Astro.props.title ?? t.meta.title;
const description = Astro.props.description ?? t.meta.description;
const canonical = new URL(path, SITE_URL).href;
const altLang = lang === 'de' ? 'en' : 'de';
const ogImage = new URL(`/og/og-${lang}.jpg`, SITE_URL).href;
const deHref = new URL(lang === 'de' ? path : altPath, SITE_URL).href;
const enHref = new URL(lang === 'en' ? path : altPath, SITE_URL).href;
const navBase = home ? '' : `/${lang}/`;
// Unterseiten markieren ihren Bereich in der Navigation
const navCur = home ? '' : /\/(funktionen|features)\//.test(path) ? '#funktionen' : /\/(berichte|reports)\//.test(path) ? '#berichte' : /\/(schritte|steps|wissen|knowledge)\//.test(path) ? '#pdca' : /\/(regelwerke|frameworks)\//.test(path) ? '#regelwerke' : /\/(whitepaper|white-paper|broschuere|brochure)\//.test(path) ? '#downloads' : /\/quick-check\//.test(path) ? '#quick-check' : '';
// Unterseiten: eine Ebene höher und zur Startseite (nebeneinander oben auf jeder Unterseite)
const de_ = lang === 'de';
const upMap: [RegExp, string, string, string][] = [
  [/^\/(de\/berichte|en\/reports)\/[^/]+\/$/, de_ ? '/de/berichte/' : '/en/reports/', 'Alle Berichte', 'All reports'],
  [/^\/(de\/berichte|en\/reports)\/$/, `/${lang}/#berichte`, 'Berichte', 'Reports'],
  [/^\/(de\/funktionen|en\/features)\//, `/${lang}/#funktionen`, 'Funktionen', 'Features'],
  [/^\/(de\/regelwerke|en\/frameworks)\//, `/${lang}/#regelwerke`, 'Regelwerke', 'Frameworks'],
  [/^\/(de\/schritte|en\/steps)\//, `/${lang}/#pdca`, 'Sechs Schritte', 'Six steps'],
  [/^\/(de\/wissen|en\/knowledge)\/[^/]+\/$/, de_ ? '/de/wissen/' : '/en/knowledge/', 'Alle Themen', 'All topics'],
  [/^\/(de\/wissen|en\/knowledge)\/$/, `/${lang}/#pdca`, 'Sechs Schritte', 'Six steps'],
  [/^\/(de|en)\/quick-check\//, `/${lang}/#quick-check`, 'Quick-Check', 'Quick check'],
  [/^\/(de\/whitepaper|en\/white-paper|de\/broschuere|en\/brochure)\//, `/${lang}/#downloads`, 'Downloads', 'Downloads'],
];
const upHit = home ? undefined : upMap.find(([re]) => re.test(path));
const up = upHit ? { href: upHit[1], label: de_ ? upHit[2] : upHit[3] } : null;
const a = t.anfrage;
const privacyHref = lang === 'de' ? '/de/datenschutz/' : '/en/privacy/';
---
<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="de" href={deHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="x-default" href={deHref} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0a1226" />
    <meta name="color-scheme" content="dark" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script src="/theme.js" is:inline></script>
    <script src="/vt.js" is:inline></script>
    <link rel="preload" href="/fonts/inter-display-800.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="UniqSuite" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t.locale} />
    <meta property="og:locale:alternate" content={lang === 'de' ? 'en_GB' : 'de_DE'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonld.map((j) => <script type="application/ld+json" is:inline set:html={JSON.stringify(j)} />)}
  </head>
  <body class={home ? 'is-home' : 'is-sub'}>
    <a class="skip" href="#inhalt">{t.skip}</a>

    <div class="world" aria-hidden="true">
      <slot name="world" />
      <div class="dim"></div>
    </div>
    <div class="labels" aria-hidden="true"><slot name="labels" /></div>
    <div class="tip" aria-hidden="true"></div>

    <header class="site-header" data-header>
      <a class="brand" href={`/${lang}/`} aria-label="UniqSuite – Start">
        <Logo id="lg-h" />
        <span>Uniq<span class="suite">Suite</span></span>
      </a>
      <nav class="site-nav" aria-label={t.nav.label}>
        {t.nav.items.map((i) => <a href={`${navBase}${i.href}`} aria-current={i.href === navCur ? 'location' : undefined}>{i.label}</a>)}
      </nav>
      <div class="header-actions">
        <button class="theme-tg" type="button" data-theme-toggle aria-pressed="false" aria-label={t.nav.themeLabel} title={t.nav.themeLabel}><Icon name="sun" class="i-sun" /><Icon name="moon" class="i-moon" /></button>
        <a class="lang" href={altPath} hreflang={altLang} lang={altLang} data-lang-switch aria-label={t.nav.langSwitchLabel}>{altLang.toUpperCase()}</a>
        <a class="btn btn-ghost btn-sm" href={demoHref(lang)} data-anfrage data-magnetic>{t.nav.demo}</a>
        <a class="btn btn-primary btn-sm" href={loginHref(lang)} data-magnetic><Icon name="login" />{t.nav.login}</a>
      </div>
      <i class="progress-line" data-progress></i>
    </header>

    <slot name="rail" />

    <main id="inhalt" tabindex="-1">
      {!home && (
        <nav class="crumbbar" aria-label={de_ ? 'Zurück' : 'Back'}>
          <div class="wrap crumb-in">
            {up && <a class="crumb crumb-up" href={up.href}><Icon name="arrow" class="flip" /><span><small>{de_ ? 'Eine Ebene höher' : 'One level up'}</small>{up.label}</span></a>}
            <a class="crumb crumb-home" href={`/${lang}/`}><Icon name="home" /><span><small>{de_ ? 'Hauptmenü' : 'Main menu'}</small>{de_ ? 'Startseite' : 'Home'}</span></a>
          </div>
        </nav>
      )}
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap foot-top">
        {!home && <a class="btn btn-ghost btn-sm" href={`/${lang}/`}><Icon name="arrow" class="flip" />{t.footer.home}</a>}
        <a class="btn btn-ghost btn-sm to-top" href="#inhalt" data-to-top>{t.footer.top}<Icon name="arrow" class="up" /></a>
      </div>
      <div class="wrap foot">
        <div>
          <a class="brand" href={`/${lang}/`} aria-label="UniqSuite – Start"><Logo id="lg-f" size={30} /><span>Uniq<span class="suite">Suite</span></span></a>
          <p>{t.footer.claim}</p>
        </div>
        <nav aria-label={t.footer.nav}>
          <ul>
            {t.footer.legal.map((l) => (
              <li>{l.external
                ? <a href={l.href} rel="noopener noreferrer">{l.label}</a>
                : <a href={l.href}>{l.label}</a>}</li>
            ))}
            <li><a href={lang === 'de' ? '/de/wissen/' : '/en/knowledge/'}>{lang === 'de' ? 'Wissen' : 'Knowledge'}</a></li>
            <li><a href={lang === 'de' ? '/de/berichte/' : '/en/reports/'}>{lang === 'de' ? 'Berichte' : 'Reports'}</a></li>
            <li><a href={altPath} hreflang={altLang} lang={altLang}>{t.nav.langSwitch}</a></li>
          </ul>
        </nav>
      </div>
    </footer>

    <a class="fab-top" href="#inhalt" data-to-top data-fab-top aria-label={t.footer.top}><Icon name="arrow" class="up" /></a>

    <dialog class="anfrage" id="anfrage" aria-labelledby="af-title" data-af-dialog data-lenis-prevent>
      <div class="anfrage-in">
        <button type="button" class="x" data-af-close aria-label={a.close}><Icon name="x" /></button>
        <div data-af-form-wrap>
          <p class="kicker"><span class="idx">→</span>{a.kicker}</p>
          <h2 id="af-title">{a.title}</h2>
          <p class="intro">{a.intro}</p>
          <form data-af-form novalidate data-lang={lang} data-mail={CONTACT_EMAIL}
            data-sending={a.sending} data-err-limit={a.errLimit} data-err-server={a.errServer}
            data-err-business={a.errBusiness} data-err-email={a.errEmail} data-err-required={a.errRequired} data-err-phone={a.errPhone}>
            <div class="af-grid">
              <div class="af-field full">
                <label for="af-company">{a.company}</label>
                <input id="af-company" name="company" type="text" required minlength="2" maxlength="160" autocomplete="organization" aria-errormessage="af-company-err" />
                <p class="af-err" id="af-company-err">{a.errRequired}</p>
              </div>
              <div class="af-field">
                <label for="af-first">{a.firstName}</label>
                <input id="af-first" name="firstName" type="text" required maxlength="80" autocomplete="given-name" aria-errormessage="af-first-err" />
                <p class="af-err" id="af-first-err">{a.errRequired}</p>
              </div>
              <div class="af-field">
                <label for="af-last">{a.lastName}</label>
                <input id="af-last" name="lastName" type="text" required maxlength="80" autocomplete="family-name" aria-errormessage="af-last-err" />
                <p class="af-err" id="af-last-err">{a.errRequired}</p>
              </div>
              <div class="af-field full">
                <label for="af-email">{a.email}</label>
                <input id="af-email" name="email" type="email" required maxlength="254" autocomplete="email" inputmode="email" spellcheck="false" aria-errormessage="af-email-err" />
                <p class="af-err" id="af-email-err" data-af-email-err>{a.errEmail}</p>
              </div>
              <div class="af-field full">
                <label for="af-phone">{a.phone} <em>{a.optional}</em></label>
                <input id="af-phone" name="phone" type="tel" maxlength="40" autocomplete="tel" aria-errormessage="af-phone-err" />
                <p class="af-err" id="af-phone-err">{a.errPhone}</p>
              </div>
              <div class="af-hp" aria-hidden="true">
                <label for="af-website">Website</label>
                <input id="af-website" name="website" type="text" tabindex="-1" autocomplete="off" />
              </div>
            </div>
            <p class="af-note">{a.note} <a href={privacyHref}>{a.noteLink}</a>.</p>
            <div class="af-actions">
              <button type="submit" class="btn btn-primary" data-af-submit>{a.submit}<Icon name="arrow" /></button>
              <p class="af-status" data-af-status role="status" aria-live="polite"></p>
            </div>
          </form>
        </div>
        <div class="af-done" data-af-done hidden>
          <div class="ok"><Icon name="check" /></div>
          <h2 tabindex="-1" data-af-done-title>{a.doneTitle}</h2>
          <p>{a.doneText}</p>
          <div class="af-actions"><button type="button" class="btn btn-ghost" data-af-close>{a.close}</button></div>
        </div>
      </div>
    </dialog>
    <div class="grain" aria-hidden="true"></div>
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
