# UniqSuite Marketing-Website – Caddy im eigenen, schreibgeschützten Container.
# TLS und HTTP→HTTPS macht der Edge-Caddy von ClaudeCWS (siehe edge-block.caddy);
# dieser Container liefert nur die statischen Dateien mit den Sicherheits-Headern aus.
{
	admin off
	auto_https off
	persist_config off
	# Der Edge-Caddy (Docker-Netz) setzt X-Forwarded-For mit der echten Client-IP.
	# Nur ihm wird vertraut; die App bremst Demo-Anfragen je IP.
	servers {
		trusted_proxies static private_ranges
	}
}

import security-headers.caddy

:8080 {
	root * /srv/current
	encode zstd gzip

	import uniqsuite_security

	# Caching
	@hashed path /_assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@static path /fonts/* /img/* /docs/* /favicon.svg /og/*
	header @static Cache-Control "public, max-age=604800"
	@html path / /*/ *.html
	header @html Cache-Control "no-cache"

	# Deutsch ist Standard
	redir / /de/ 301

	# Demo-Anfrage (Formular): der EINZIGE Pfad, der an die App geht – nur POST,
	# kleiner Body, ohne Cookies/Authorization. Ziel ist der Web-Container der App
	# (nginx -> api /functions/website-anfrage) im gemeinsamen Netz uniqsuite_edge.
	handle /api/anfrage {
		@post method POST
		handle @post {
			request_body {
				max_size 8KB
			}
			rewrite * /functions/website-anfrage
			reverse_proxy uniqsuite-web:80 {
				header_up -Cookie
				header_up -Authorization
			}
		}
		respond 405
	}

	# Nur GET/HEAD (statische Seite)
	@notread not method GET HEAD
	respond @notread 405

	# Versteckte Dateien nie ausliefern (außer .well-known)
	@hidden {
		path */.*
		not path /.well-known/*
	}
	respond @hidden 404

	try_files {path} {path}/index.html
	file_server

	handle_errors {
		rewrite * /404.html
		file_server
	}
}
