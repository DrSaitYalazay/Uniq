# UniqSuite Marketing-Website – Caddy im eigenen, schreibgeschützten Container.
# TLS und HTTP→HTTPS macht der Edge-Caddy von ClaudeCWS (siehe edge-block.caddy);
# dieser Container liefert nur die statischen Dateien mit den Sicherheits-Headern aus.
{
	admin off
	auto_https off
	persist_config off
}

import security-headers.caddy

:8080 {
	root * /srv/current
	encode zstd gzip

	import uniqsuite_security

	# Caching
	@hashed path /_assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@static path /fonts/* /img/* /docs/* /favicon.svg /og/*
	header @static Cache-Control "public, max-age=604800"
	@html path / /*/ *.html
	header @html Cache-Control "no-cache"

	# Deutsch ist Standard
	redir / /de/ 301

	# Nur GET/HEAD (statische Seite)
	@notread not method GET HEAD
	respond @notread 405

	# Versteckte Dateien nie ausliefern (außer .well-known)
	@hidden {
		path */.*
		not path /.well-known/*
	}
	respond @hidden 404

	try_files {path} {path}/index.html
	file_server

	handle_errors {
		rewrite * /404.html
		file_server
	}
}
