# Lokaler Test: gleiche Header wie in Produktion, ohne TLS. Start: caddy run --config deploy/Caddyfile.local
{
	auto_https off
	admin off
}
import security-headers.caddy

:8090 {
	root * ../dist
	encode zstd gzip
	import uniqsuite_security
	header -Strict-Transport-Security
	@hashed path /_assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@static path /fonts/* /img/* /docs/* /favicon.svg /og/*
	header @static Cache-Control "public, max-age=604800"
	redir / /de/ 301
	# lokaler Test der Demo-Anfrage gegen eine lokal laufende API
	handle /api/anfrage {
		rewrite * /functions/website-anfrage
		reverse_proxy 127.0.0.1:18080
	}
	try_files {path} {path}/index.html
	file_server
	handle_errors {
		rewrite * /404.html
		file_server
	}
}
