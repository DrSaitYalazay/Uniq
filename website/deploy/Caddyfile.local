# Lokaler Test: gleiche Header wie in Produktion, ohne TLS. Start: caddy run --config deploy/Caddyfile.local
{
	auto_https off
	admin off
}
import security-headers.caddy

:8090 {
	root * ../dist
	encode zstd gzip
	import uniqsuite_security
	header -Strict-Transport-Security
	@hashed path /_assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	# Bilder, PDFs, OG-Bilder: Der Build hängt ?v=<Inhalts-Hash> an (scripts/version-assets.mjs).
	# Versionierte Adressen ändern sich mit dem Inhalt und dürfen ewig gecacht werden;
	# unversionierte werden bei jedem Aufruf nachgeprüft (ETag, meist 304), damit nie Altes stehen bleibt.
	@versioned {
		path /img/* /docs/* /og/*
		query v=*
	}
	header @versioned Cache-Control "public, max-age=31536000, immutable"
	@revalidate {
		path /img/* /docs/* /og/*
		not query v=*
	}
	header @revalidate Cache-Control "no-cache"
	@static path /fonts/* /favicon.svg
	header @static Cache-Control "public, max-age=604800"
	redir / /de/ 301
	# lokaler Test der Demo-Anfrage gegen eine lokal laufende API
	handle /api/anfrage {
		rewrite * /functions/website-anfrage
		reverse_proxy 127.0.0.1:18080
	}
	try_files {path} {path}/index.html
	file_server
	handle_errors {
		rewrite * /404.html
		file_server
	}
}
